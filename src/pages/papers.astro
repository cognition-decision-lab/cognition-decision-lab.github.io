---
import Layout from '../layouts/Layout.astro'
import papers from '../data/papers.json'

// Papers are rendered newest-first, sorted here rather than relying on the order
// of papers.json. Accepts "forthcoming", "Month YYYY", "Month D, YYYY" and "YYYY".
const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december']
function dateKey(raw) {
  const d = String(raw ?? '').trim()
  if (d.toLowerCase() === 'forthcoming') return [9999, 12, 31]
  let m = d.match(/^([A-Za-z]+)\s+(\d{1,2}),\s*(\d{4})$/)
  if (m && MONTHS.includes(m[1].toLowerCase())) return [+m[3], MONTHS.indexOf(m[1].toLowerCase()) + 1, +m[2]]
  m = d.match(/^([A-Za-z]+)\s+(\d{4})$/)
  if (m && MONTHS.includes(m[1].toLowerCase())) return [+m[2], MONTHS.indexOf(m[1].toLowerCase()) + 1, 0]
  m = d.match(/^(\d{4})$/)
  if (m) return [+m[1], 0, 0]
  return [0, 0, 0]   // unparseable dates sink to the bottom rather than breaking the build
}
function byDateDesc(a, b) {
  const x = dateKey(a.date), y = dateKey(b.date)
  return (y[0] - x[0]) || (y[1] - x[1]) || (y[2] - x[2])
}
const select = (section, type) => papers.filter(p => p.section === section && p.type === type).sort(byDateDesc)

// NOTE: papers.json still records `volume`, `issue` and `pages`, but the citation
// line deliberately does NOT display any of them (decision 2026-10-15). The data is
// kept so it is there if it is ever wanted again. A citation renders as:
//     "Title", Authors, Journal, Date
// To show them again, add back inside the <li> below, in this order:
//   {paper.volume ? `, Volume ${paper.volume}` : ''}
//   {paper.issue ? `, Issue ${paper.issue}` : ''}
//   {paper.pages ? `, ${/[-\u2010-\u2015]/.test(String(paper.pages)) ? `Pages ${paper.pages}` : `Article ${paper.pages}`}` : ''}
// (the dash test matters: journals like PNAS and eLife number articles rather than
// paginating, so "Pages e2407540122" would be wrong)
---
<Layout>
  <style>
    section p, section li {
      text-align: justify;
      word-break: break-word;
      hyphens: auto;
    }
  </style>
  {['economic-decision-making', 'bounded-rationality', 'behavioral-economic-links', 'neuroeconomics', 'other'].map(section => (
    <section class="py-12" id={section}>
      <h1 class="text-4xl font-bold mb-8">
        {section === 'economic-decision-making' && 'Economic Decision Making with Limited Attention'}
        {section === 'bounded-rationality' && 'Bounded Rationality in Macroeconomics'}
        {section === 'behavioral-economic-links' && 'Links Between Behavioral and Economic Phenomena'}
        {section === 'neuroeconomics' && 'Neuroeconomics'}
        {section === 'other' && 'Other'}
      </h1>
      <div class="space-y-8">
        <h2 class="text-2xl font-bold mb-4">Published Papers</h2>
        <ul class="list-disc ml-8 space-y-2">
          {select(section, 'published').map(paper => (
            <li>
              <span class="text-blue-600">
                {paper.url ? (
                  <a href={paper.url} target="_blank" rel="noopener noreferrer" class="hover:underline">"{paper.title}"</a>
                ) : (
                  `"${paper.title}"`
                )}
              </span>, {paper.authors.join(', ')}{paper.journal ? `, ${paper.journal}` : ''}{paper.date ? `, ${paper.date}` : ''}
            </li>
          ))}
        </ul>
        <h2 class="text-2xl font-bold mt-8 mb-4">Working Papers</h2>
        <ul class="list-disc ml-8 space-y-2">
          {select(section, 'working').map(paper => (
            <li>
              <span class="text-blue-600">
                {paper.url ? (
                  <a href={paper.url} target="_blank" rel="noopener noreferrer" class="hover:underline">"{paper.title}"</a>
                ) : (
                  `"${paper.title}"`
                )}
              </span>, {paper.authors.join(', ')}{paper.date ? `, ${paper.date}` : ''}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Layout>
